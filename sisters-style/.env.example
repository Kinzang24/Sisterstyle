# Required — generate a random secret: `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=replace-me-with-a-random-string

# Used to build absolute URLs (e.g. Stripe redirect URLs). Set to your real
# domain in production.
NEXTAUTH_URL=http://localhost:3000

# --- Payments (optional) -----------------------------------------------
# Stripe only supports merchant accounts in a limited set of countries
# (Bhutan isn't currently one of them) — see lib/payments.js for context.
# Leave these blank to run with Cash on Delivery only, which needs no
# external account at all.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Approximate BTN-per-USD rate used only if Stripe is enabled (Stripe
# charges in USD since it doesn't support BTN as a presentment currency).
NU_PER_USD=95
